{
  "name": "daniel-xing-portfolio",
  "private": true,
  "version": "0.1.0",
  "description": "Daniel Xing's pixel room portfolio (Phaser 3 + TypeScript + Vite).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "photos": "node scripts/photos.mjs",
    "predev": "node scripts/photos.mjs --quiet",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "terser": "^5.39.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  }
}
